# Local development without Firebase: uncomment to read/write JSON files in .data/
# instead of Firestore. The FIREBASE_* vars below are then optional. Run `npm run sync`
# with the dev server up to populate it. Development only.
# DATA_STORE=local

# Firebase Admin SDK (server-side only — not exposed to browser)
# Find these in Firebase Console → Project Settings → Service accounts → Generate new private key
# Either set FIREBASE_SERVICE_ACCOUNT to the full service account JSON (one line)...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"lansing-codes",...}
# ...or set the three separate vars below
FIREBASE_PROJECT_ID=lansing-codes
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lansing-codes.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Secret token to protect /api/sync/* routes (generate with: openssl rand -base64 32)
SYNC_SECRET=your-secret-token-here

# Base URL for internal API calls (used by /api/sync/all and scheduled-sync)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mailchimp API key for newsletter subscriptions
# Get from: Mailchimp → Account & Billing → Extras → API keys → Create A Key
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us19
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
